NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Readonly timesheet page
READONLY_TIMESHEET_PASSWORD=your-shared-readonly-password
# Preferred: per-store passwords (store id or store name as key)
# Example: {"Teras":"pass-for-teras","BelRay":"pass-for-belray"}
READONLY_STORE_PASSWORDS_JSON={"store-id-or-name":"password"}
# Optional (recommended): separate signing key for readonly session cookies
READONLY_TIMESHEET_SECRET=your-random-long-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
